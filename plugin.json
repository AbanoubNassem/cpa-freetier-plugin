{
  "name": "cpa-freetier-plugin",
  "version": "1.2.5",
  "description": "Curated zero-key free AI models (Nemotron 550B, Space Bunny 1M, North Mini Code) with automatic agent payload sanitization.",
  "license": "MIT",
  "repository": "https://github.com/tsaQB/cpa-freetier-plugin",
  "cli_proxy_api": {
    "abi_version": 1,
    "entrypoint": "cpa-freetier-plugin.so",
    "build": "make build",
    "capabilities": [
      "model_provider",
      "executor",
      "request_normalizer"
    ],
    "input_formats": [
      "chat-completions"
    ],
    "output_formats": [
      "chat-completions"
    ]
  }
}
